# Copy to .env and fill in values.

# --- Local PostgreSQL (same for both) ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_delivery"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/campus_delivery"

# --- Supabase (from Project Settings → Database) ---
# 1) "Connection string" → URI → use the **direct** connection (host db.xxx.supabase.co, port **5432**) for DIRECT_URL.
# 2) For DATABASE_URL, use the **pooler** (Session mode) URI on port **6543** and append:
#    ?pgbouncer=true&connection_limit=1
#    Example shape:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

JWT_SECRET="change-me-in-production"

# Supabase Dashboard → Project Settings → API → JWT Secret (signing key).
# Required so the backend can verify Supabase access tokens and place orders as a student.
# SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Comma-separated emails that get ADMIN on Supabase login (must match Supabase Auth email)
# ADMIN_EMAILS="admin@example.com"
